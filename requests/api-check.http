###############################################################################
# Team05 Cafe — API 확인 요청 (A01~A24 정상 요청 + 오류 요청)
#
# 실행 순서
#   1. 새 DB에 프로젝트 루트의 init.sql 실행 (카테고리 1·2, 메뉴 1~4가 생김)
#   2. Redis·백엔드 실행 후, 이 파일을 위에서부터 순서대로 하나씩 실행
#   3. 아래 "직접 입력" 변수는 앞 요청의 응답을 보고 바꿔 넣는다
#
# 기대 값은 init.sql 직후의 새 DB에서 이 파일을 처음부터 실행했을 때 기준
###############################################################################

@baseUrl = http://127.0.0.1:8080

# ── 고정 변수 (init.sql 데이터 기준) ──
@categoryId = 1
@menuId = 1
@toggleMenuId = 4
@email = buyer@example.com
@keyword = Columbia

# ── 직접 입력 변수 (앞 요청의 응답 값으로 바꿔 넣기) ──
# newCategoryId: A03 응답의 id / newMenuId: A08 응답의 id / orderId: A11 응답의 id
# shippingDate: A11 응답의 shippingDate / date: A11을 실행한 날(서울 기준 접수일)
@newCategoryId = 3
@newMenuId = 5
@orderId = 1
@shippingDate = 2026-11-06
@date = 2026-11-06
# expiredOrderId: 배송일 14:00이 이미 지난 PLACED 주문 id (오류 요청 409 확인용)
@expiredOrderId = 1


###############################################################################
# 카테고리 A01~A05
###############################################################################

### A01 카테고리 목록 — GET /api/v1/categories → 200 Category[]
# 기대: 200, ID 오름차순 [ {id:1, 싱글오리진}, {id:2, 블렌드} ]
GET {{baseUrl}}/api/v1/categories

### A02 카테고리 상세 — GET /api/v1/categories/{categoryId} → 200 Category
# 기대: 200, {id:1, name:"싱글오리진"}
GET {{baseUrl}}/api/v1/categories/{{categoryId}}

### A03 카테고리 등록 — POST /api/v1/categories → 201 Category
# 기대: 201, name="Decaf", 새 id 생성
# 다음: 응답 id를 @newCategoryId에 넣는다
POST {{baseUrl}}/api/v1/categories
Content-Type: application/json

{
  "name": "Decaf"
}

### A03-1 앞뒤 공백 제거 후 중복 검사
# 기대: 409, code=CATEGORY_NAME_DUPLICATED (공백을 제거하면 "Decaf"와 같음)
POST {{baseUrl}}/api/v1/categories
Content-Type: application/json

{
  "name": "  Decaf  "
}

### A03-2 대소문자 구분 검사
# 기대: 201 (대소문자가 다르면 다른 이름으로 본다)
POST {{baseUrl}}/api/v1/categories
Content-Type: application/json

{
  "name": "decaf"
}

### A04 카테고리 수정 — PUT /api/v1/categories/{categoryId} → 200 Category
# 준비: A03에서 만든 카테고리
# 기대: 200, name="Decaf Blend"
PUT {{baseUrl}}/api/v1/categories/{{newCategoryId}}
Content-Type: application/json

{
  "name": "Decaf Blend"
}

### A05 카테고리 삭제 — DELETE /api/v1/categories/{categoryId} → 204
# 준비: A03에서 만든 카테고리 (소속 메뉴 없음)
# 기대: 204, 빈 본문
DELETE {{baseUrl}}/api/v1/categories/{{newCategoryId}}


###############################################################################
# 메뉴 A06~A10, A15, A19~A21
###############################################################################

### A06 전체 메뉴 — GET /api/v1/menus → 200 Menu[]
# 기대: 200, ID 오름차순 메뉴 4개, 판매 중지 메뉴도 포함 (Redis 캐시 menus::all)
GET {{baseUrl}}/api/v1/menus

### A07 메뉴 상세 — GET /api/v1/menus/{menuId} → 200 Menu
# 기대: 200, {id:1, name:"Columbia Nariñó", price:5000, available:true}
GET {{baseUrl}}/api/v1/menus/{{menuId}}

### A08 메뉴 등록 — POST /api/v1/menus → 201 Menu
# 기대: 201, available=true, 새 id 생성 (블렌드 카테고리에 등록)
# 다음: 응답 id를 @newMenuId에 넣는다
POST {{baseUrl}}/api/v1/menus
Content-Type: application/json

{
  "categoryId": 2,
  "name": "House Blend",
  "price": 6000,
  "description": "블렌드 원두 패키지입니다."
}

### A09 메뉴 일반 수정 — PUT /api/v1/menus/{menuId} → 200 Menu
# 준비: A08에서 만든 메뉴
# 기대: 200, name="House Blend Dark", price=6500, available은 기존 값(true) 유지
PUT {{baseUrl}}/api/v1/menus/{{newMenuId}}
Content-Type: application/json

{
  "categoryId": 2,
  "name": "House Blend Dark",
  "price": 6500,
  "description": "다크 로스팅 블렌드 원두 패키지입니다."
}

### A10 메뉴 삭제 — DELETE /api/v1/menus/{menuId} → 204
# 준비: A08에서 만든 메뉴 (주문에 쓰인 적 없음)
# 기대: 204, 빈 본문
DELETE {{baseUrl}}/api/v1/menus/{{newMenuId}}

### A15 카테고리별 메뉴 — GET /api/v1/categories/{categoryId}/menus → 200 Menu[]
# 기대: 200, 싱글오리진 소속 메뉴 1~4 (ID 오름차순)
GET {{baseUrl}}/api/v1/categories/{{categoryId}}/menus

### A19 판매 중 메뉴 — GET /api/v1/menus/available → 200 Menu[]
# 기대: 200, available=true 메뉴만 ID 오름차순 (Redis 캐시 menus::availableList)
GET {{baseUrl}}/api/v1/menus/available

### A20 메뉴명 검색 — GET /api/v1/menus/search?keyword={keyword} → 200 Menu[]
# 기대: 200, 이름에 "Columbia"가 들어간 메뉴 1·3 (대소문자 구분, ID 오름차순)
GET {{baseUrl}}/api/v1/menus/search?keyword={{keyword}}

### A20-1 %·_는 일반 문자로 검색
# 기대: 200, [] (이름에 "_"가 들어간 메뉴가 없음)
GET {{baseUrl}}/api/v1/menus/search?keyword=_

### A21 판매 여부 변경 — PUT /api/v1/menus/{menuId}/availability → 200 Menu
# 준비: 주문에 쓰지 않는 메뉴 4 (A11·A23 주문에 영향이 없도록)
# 기대: 200, available=false
PUT {{baseUrl}}/api/v1/menus/{{toggleMenuId}}/availability
Content-Type: application/json

{
  "available": false
}

### A21-1 판매 재개 (원래대로 되돌리기)
# 기대: 200, available=true
PUT {{baseUrl}}/api/v1/menus/{{toggleMenuId}}/availability
Content-Type: application/json

{
  "available": true
}


###############################################################################
# 주문·배송 A11~A14, A16, A22, A23
###############################################################################

### A11 주문 접수 — POST /api/v1/orders → 201 Order
# 기대: 201, status=PLACED, cancelledAt=null, memo="", totalAmount=17000
#       items: 메뉴1 5000×2=10000, 메뉴2 7000×1=7000
# 다음: 응답 id → @orderId, shippingDate → @shippingDate, 오늘 날짜 → @date
POST {{baseUrl}}/api/v1/orders
Content-Type: application/json

{
  "email": "buyer@example.com",
  "address": "서울시 실습로 10 101호",
  "postcode": "01234",
  "items": [
    { "menuId": 1, "quantity": 2 },
    { "menuId": 2, "quantity": 1 }
  ]
}

### A12 이메일별 주문 — GET /api/v1/orders?email={email} → 200 OrderSummary[]
# 기대: 200, [ {id:@orderId, totalAmount:17000, status:PLACED} ] (접수 시각 내림차순)
GET {{baseUrl}}/api/v1/orders?email={{email}}

### A13 주문 상세 — GET /api/v1/orders/{orderId} → 200 Order
# 기대: 200, A11 응답과 같은 내용
GET {{baseUrl}}/api/v1/orders/{{orderId}}

### A14 배송 묶음 — GET /api/v1/delivery-batches?shippingDate={shippingDate} → 200 DeliveryBatch[]
# 기대: 200, buyer@example.com 묶음 1개, orderIds=[@orderId], totalQuantity=3, totalAmount=17000
GET {{baseUrl}}/api/v1/delivery-batches?shippingDate={{shippingDate}}

### A22 주문 메모 수정 — PUT /api/v1/orders/{orderId}/memo → 200 Order
# 기대: 200, memo가 앞뒤 공백·줄바꿈까지 그대로 저장됨 (다른 필드는 그대로)
PUT {{baseUrl}}/api/v1/orders/{{orderId}}/memo
Content-Type: application/json

{
  "memo": "  문 앞에\n놓아 주세요  "
}

### A22-1 메모 비우기
# 기대: 200, memo=""
PUT {{baseUrl}}/api/v1/orders/{{orderId}}/memo
Content-Type: application/json

{
  "memo": ""
}

### A16 주문 취소 — POST /api/v1/orders/{orderId}/cancel → 200 Order
# 준비: 배송일 14:00:00 전에 실행
# 기대: 200, status=CANCELLED, cancelledAt=취소한 시각, totalAmount·items는 접수 때와 같음
POST {{baseUrl}}/api/v1/orders/{{orderId}}/cancel

### A16-1 이미 취소한 주문 다시 취소
# 기대: 200, 기존 주문 그대로 (cancelledAt은 처음 취소한 시각 유지)
POST {{baseUrl}}/api/v1/orders/{{orderId}}/cancel

### A17 접수일별 주문 통계 — GET /api/v1/statistics/orders?date={date} → 200 OrderStatistics
# 기대: 200, orderCount=1, placedOrderCount=0, cancelledOrderCount=1, totalQuantity=0, totalAmount=0
#       (취소한 주문은 주문 수에는 들어가고 수량·금액에서는 빠짐)
GET {{baseUrl}}/api/v1/statistics/orders?date={{date}}

### A17-1 주문이 없는 날짜
# 기대: 200, 모든 값이 0인 객체 (404 아님)
GET {{baseUrl}}/api/v1/statistics/orders?date=2000-01-01

### A18 접수일별 메뉴 통계 — GET /api/v1/statistics/menus?date={date} → 200 MenuStatistics[]
# 기대: 200, [] (그날 주문은 모두 취소됨 → PLACED만 집계하므로 비어 있음)
GET {{baseUrl}}/api/v1/statistics/menus?date={{date}}

### A23 재주문 — POST /api/v1/orders/{orderId}/reorder → 201 새 Order
# 준비: A16에서 취소한 주문 (취소한 주문도 재주문 가능)
# 기대: 201, 새 id, status=PLACED, cancelledAt=null, memo="", 현재 메뉴 가격으로 totalAmount=17000
#       원본 주문(@orderId)은 CANCELLED 그대로
POST {{baseUrl}}/api/v1/orders/{{orderId}}/reorder

### A24 접수일별 고객 통계 — GET /api/v1/statistics/customers?date={date} → 200 CustomerStatistics[]
# 기대: 200, [ {email:buyer@example.com, orderCount:2, placedOrderCount:1, cancelledOrderCount:1,
#              totalQuantity:3, totalAmount:17000} ] (이메일 오름차순, 대소문자 구분)
GET {{baseUrl}}/api/v1/statistics/customers?date={{date}}


###############################################################################
# 오류 요청 — 팀 최종 6개 (입력 오류 400 2개 / 대상 없음 404 1개 / 업무 조건 위반 409 3개)
# 서로 다른 검사 조건 6가지. 모든 오류 응답은 code·message·fieldErrors를 포함하고,
# 거절된 요청은 데이터를 바꾸지 않는다. 위의 정상 요청(A11 포함)을 먼저 실행한 뒤 실행한다.
###############################################################################

### [오류 1/6 · 400] URL 날짜가 실제로 없는 날짜 (A17)
# 검사 조건: URL 날짜는 2000-01-01~2099-12-31의 실제 날짜여야 함
# 기대: 400, code=VALIDATION_ERROR, message="입력값을 확인해 주세요.", fieldErrors.date 있음
GET {{baseUrl}}/api/v1/statistics/orders?date=2026-02-30

### [오류 2/6 · 400] ID 범위 오류 (A02)
# 검사 조건: ID는 1 이상의 정수 (1번과 다른 규칙)
# 기대: 400, code=VALIDATION_ERROR, message="입력값을 확인해 주세요.", fieldErrors.categoryId 있음
GET {{baseUrl}}/api/v1/categories/0

### [오류 3/6 · 404] 존재하지 않는 카테고리 (A02)
# 검사 조건: 형식은 맞지만 대상이 없음
# 기대: 404, code=CATEGORY_NOT_FOUND, message="카테고리를 찾을 수 없습니다.", fieldErrors={}
GET {{baseUrl}}/api/v1/categories/999999

### [오류 4/6 · 409] 카테고리명 중복 등록 (A03)
# 검사 조건: 다른 카테고리와 이름이 같으면 등록 불가 (init.sql의 "싱글오리진")
# 기대: 409, code=CATEGORY_NAME_DUPLICATED, message="같은 이름의 카테고리가 이미 있습니다.", fieldErrors={}
POST {{baseUrl}}/api/v1/categories
Content-Type: application/json

{
  "name": "싱글오리진"
}

### [오류 5/6 · 409] 메뉴가 등록된 카테고리 삭제 (A05)
# 검사 조건: 소속 메뉴가 하나라도 있으면 삭제 불가 (싱글오리진에는 메뉴 1~4가 있음)
# 기대: 409, code=CATEGORY_IN_USE, message="메뉴가 등록된 카테고리는 삭제할 수 없습니다.", fieldErrors={}
#       카테고리는 그대로 남음 (A01로 다시 조회해 확인)
DELETE {{baseUrl}}/api/v1/categories/{{categoryId}}

### [오류 6/6 · 409] 주문에 사용된 메뉴 삭제 (A10)
# 검사 조건: 한 번이라도 주문에 쓰인 메뉴는 삭제 불가 (취소 주문 포함)
# 준비: A11에서 메뉴 1을 주문함
# 기대: 409, code=MENU_IN_USE, message="주문에 사용된 메뉴는 삭제할 수 없습니다.", fieldErrors={}
#       메뉴는 그대로 남음 (A07로 다시 조회해 확인)
DELETE {{baseUrl}}/api/v1/menus/{{menuId}}


###############################################################################
# 참고 — 추가 확인용 오류 요청 (최종 6개에는 포함하지 않음)
###############################################################################

### [참고 · 400] A18 날짜 형식 오류 (YYYY-MM-DD가 아님)
# 기대: 400, code=VALIDATION_ERROR, fieldErrors.date 있음
GET {{baseUrl}}/api/v1/statistics/menus?date=2026-11-4

### [참고 · 400] A18 날짜 누락
# 기대: 400, code=VALIDATION_ERROR, fieldErrors.date 있음
GET {{baseUrl}}/api/v1/statistics/menus

### [참고 · 400] ID 자료형 오류
# 기대: 400, code=VALIDATION_ERROR, fieldErrors.categoryId 있음
GET {{baseUrl}}/api/v1/categories/abc

### [참고 · 400] 검색어 누락
# 기대: 400, code=VALIDATION_ERROR, fieldErrors.keyword 있음
GET {{baseUrl}}/api/v1/menus/search

### [참고 · 409] A16 취소 마감(배송일 14:00:00)이 지난 주문 취소
# 준비: 배송일이 이미 지난 PLACED 주문의 id를 @expiredOrderId에 넣는다 (예: 전날 14시 전에 접수한 주문)
#       init.sql 직후의 새 DB에는 이런 주문이 없으므로, 하루가 지난 뒤 실행하거나 이 경계는
#       자동 테스트(OrderChangeServiceTest, Clock 고정)로 확인한다.
#       이미 취소된 주문 id를 넣으면 마감과 관계없이 200이 나온다 (A16-1 규칙)
# 기대: 409, code=ORDER_NOT_CANCELLABLE, fieldErrors={}, 주문 상태는 PLACED 그대로
POST {{baseUrl}}/api/v1/orders/{{expiredOrderId}}/cancel
